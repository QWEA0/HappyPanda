{
  "name": "happypanda",
  "version": "0.1.0",
  "private": true,
  "description": "Personal SSH desktop workspace for remote Claude Code",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "start": "node scripts/desktop.mjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "node scripts/package.mjs pack",
    "portable": "node scripts/package.mjs portable",
    "proof": "node research/verify-local-execution.mjs",
    "install:sync": "node scripts/install-mutagen.mjs",
    "smoke:remote": "tsx scripts/remote-smoke.ts",
    "smoke:providers": "tsx scripts/provider-smoke.ts",
    "smoke:login": "tsx scripts/login-browser-smoke.ts",
    "smoke:clipboard": "node scripts/clipboard-smoke.cjs",
    "smoke:clipboard-copy": "node scripts/clipboard-copy-smoke.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.55.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh-config": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.happypanda.desktop",
    "productName": "HappyPanda",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "bootstrap.py",
          "hp_remote.py",
          "import_memory.py",
          "upload_image.py"
        ]
      },
      {
        "from": ".local/tools",
        "to": "tools",
        "filter": [
          "mutagen*",
          "mutagen-install.json"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "npmRebuild": false
  },
  "author": "HappyPanda"
}
